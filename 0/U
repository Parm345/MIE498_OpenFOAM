FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
    location    "0";
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (0 1 0);
    }

    "(outerwall|cube|upperwall)"
    {
        type            noSlip;
    }

    outerwall
    {
        type          noSlip;
    }

    cube
    {
        type          noSlip;
    }

    upperwall
    {
        type          noSlip;
    }

    outlet
    {
        type            zeroGradient; 
    }
}


