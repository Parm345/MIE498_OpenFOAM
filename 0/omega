FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 8.86;

boundaryField
{
    // "(movingWall|fixedWalls)"
    // {
    //     type            omegaWallFunction;
    //     value           uniform 22.4;
    // }


    inlet
    {
        type            fixedValue;
        value           uniform 8.86; 
    }

    "(outerwall|cube|upperwall)"
    {
        type            omegaWallFunction;
        value           uniform 8.86;
    }

    outlet
    {
        type            zeroGradient;
    }

