FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];
internalField   uniform 4.34e-5;   // example value (see note below)
boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 4.34e-5;  // nu_t ≈ C_mu * k^2 / epsilon (example)
    }

    outlet
    {
        type            zeroGradient;
    }

    "(outerwall|cube|upperwall)"
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
}



