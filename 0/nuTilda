FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nuTilda;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 5.00e-6;

boundaryField
{
    /* "(movingWall|fixedWalls)"
    {
        type            zeroGradient;
    } */
    inlet
    {
        type            fixedValue;
        value           uniform 5.00e-6;  // 5 x nu_laminar (water viscosity at 20C)
    }

    outlet
    {
        type            zeroGradient;
    }

    /* frontAndBack
    {
        type            empty;
    } */

    "(outerwall|cube|upperwall)"
    {
        // value           uniform 0;
        type            zeroGradient;
    }
}


